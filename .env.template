# BuildBridge-MCP Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# ==========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_PROJECT_ID=your-google-project-id

# OAuth token storage (optional - will use default if not set)
GOOGLE_TOKEN_FILE=config/token.pickle

# ==========================================
# GOOGLE SHEETS PROJECT CONFIGURATION
# ==========================================
# Google Sheets IDs for each project (get from sheet URL)
GOOGLE_SHEETS_PROJECT_72_PERTH=your-72-perth-sheet-id
GOOGLE_SHEETS_PROJECT_17175_YONGE_ST=your-17175-yonge-st-sheet-id
GOOGLE_SHEETS_PROJECT_AZURE_ROAD=your-azure-road-sheet-id

# ==========================================
# OPENAI CONFIGURATION
# ==========================================
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=3

# ==========================================
# APPLICATION SETTINGS
# ==========================================
LOCAL_MODE=true
LOG_LEVEL=INFO
DEBUG=false

# ==========================================
# DEVELOPMENT NOTES
# ==========================================
# - This file contains sensitive credentials
# - Keep it secure and never commit to git
# - Use different values for dev/staging/production
# - Rotate credentials regularly
# - See docs/SECURITY_CONFIG_GUIDE.md for details
DEBUG=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://username:password@localhost:5432/buildbridge

# Azure Configuration (if using Azure OpenAI)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview