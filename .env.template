# BuildBridge-MCP Environment Configuration Template
# Copy this file to .env and update with your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# AI Service Configuration (optional - these override config/credentials.json)
AI_MODEL=gpt-4-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.1
AI_MAX_RETRIES=3

# Application Configuration
LOCAL_MODE=true
DEBUG=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://username:password@localhost:5432/buildbridge

# Azure Configuration (if using Azure OpenAI)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview