# BuildBridge-MCP Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# ==========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_PROJECT_ID=your-google-project-id

# OAuth token storage (optional - will use default if not set)
GOOGLE_TOKEN_FILE=config/token.pickle

# ==========================================
# MICROSOFT SHAREPOINT / ONEDRIVE CONFIGURATION
# ==========================================
# App registration values from Microsoft Entra (Azure AD)
SHAREPOINT_CLIENT_ID=your-entra-client-id
SHAREPOINT_CLIENT_SECRET=your-entra-client-secret
SHAREPOINT_TENANT_ID=your-entra-tenant-id
SHAREPOINT_SITE=https://yourcompany.sharepoint.com/sites/construction

# Optional: override list names (JSON string) e.g.
# {"projects": "Projects", "tasks": "Tasks"}
# SHAREPOINT_LISTS_JSON={}

# ==========================================
# GOOGLE SHEETS PROJECT CONFIGURATION
# ==========================================
# Just add project NAME and ID - smart defaults handle the rest!
# Add as many projects as needed by incrementing the number
GOOGLE_SHEETS_PROJECT_1_NAME=Project_A
GOOGLE_SHEETS_PROJECT_1_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_PROJECT_2_NAME=Project_B
GOOGLE_SHEETS_PROJECT_2_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_PROJECT_3_NAME=Project_C
GOOGLE_SHEETS_PROJECT_3_ID=your-spreadsheet-id-here

# ==========================================
# GOOGLE SHEETS DEFAULT TAB CONFIGURATION
# ==========================================
# Convention-based defaults (applies to all projects unless overridden)
# These are the standard tab names expected in all project spreadsheets
GOOGLE_SHEETS_DEFAULT_PROJECT_SUMMARY_TAB=Project Summary
GOOGLE_SHEETS_DEFAULT_GCA_STATS_TAB=GCA Stats
GOOGLE_SHEETS_DEFAULT_CELL_RANGE=A1:AZ200
GOOGLE_SHEETS_DEFAULT_GCA_RANGE=A1:BI200

# ==========================================
# ADVANCED: PROJECT-SPECIFIC TAB OVERRIDES (Optional)
# ==========================================
# Only uncomment and customize if a specific project uses different tab names
# This is rarely needed - the defaults above work for 95% of cases
# GOOGLE_SHEETS_PROJECT_2_SUMMARY_TAB=Executive Summary
# GOOGLE_SHEETS_PROJECT_2_GCA_TAB=Building Statistics
# GOOGLE_SHEETS_PROJECT_1_BELOW_GRADE_TAB=BG1
# GOOGLE_SHEETS_PROJECT_1_ABOVE_GRADE_TAB=AG - A

# ==========================================
# OPENAI CONFIGURATION
# ==========================================
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=3

# ==========================================
# APPLICATION SETTINGS
# ==========================================
LOCAL_MODE=true
LOG_LEVEL=INFO
DEBUG=false

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==========================================
# OPTIONAL: AZURE OPENAI (Alternative to OpenAI)
# ==========================================
# Uncomment if using Azure OpenAI instead of direct OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ==========================================
# OPTIONAL: DATABASE (Future Use)
# ==========================================
# DATABASE_URL=postgresql://username:password@localhost:5432/buildbridge

# ==========================================
# DEVELOPMENT NOTES
# ==========================================
# - This file contains sensitive credentials
# - Keep it secure and never commit to git
# - Use different values for dev/staging/production
# - Rotate credentials regularly
# - For adding new projects, just add GOOGLE_SHEETS_PROJECT_{N}_NAME and _ID
# - No JSON editing required!