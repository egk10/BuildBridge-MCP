# BuildBridge-MCP Production Environment Configuration
# Copy this file to .env and update with your production values

# ==========================================
# PRODUCTION ENVIRONMENT SETTINGS
# ==========================================
ENVIRONMENT=production
LOG_LEVEL=WARNING
DEBUG=false
LOCAL_MODE=false

# ==========================================
# GOOGLE OAUTH CONFIGURATION (Production)
# ==========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# Use production OAuth credentials, not development ones
GOOGLE_CLIENT_ID=your-production-client-id
GOOGLE_CLIENT_SECRET=your-production-client-secret
GOOGLE_PROJECT_ID=your-production-project-id

# OAuth token storage (optional - will use default if not set)
GOOGLE_TOKEN_FILE=config/token.pickle

# ==========================================
# GOOGLE SHEETS PROJECT CONFIGURATION (Production)
# ==========================================
# Google Sheets IDs for production projects (get from sheet URL)
GOOGLE_SHEETS_PROJECT_72_PERTH=your-production-sheet-id-1
GOOGLE_SHEETS_PROJECT_17175_YONGE_ST=your-production-sheet-id-2
GOOGLE_SHEETS_PROJECT_AZURE_ROAD=your-production-sheet-id-3

# ==========================================
# OPENAI CONFIGURATION (Production)
# ==========================================
OPENAI_API_KEY=your-production-openai-key
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=3

# ==========================================
# AZURE OPENAI CONFIGURATION (Optional)
# ==========================================
# If using Azure OpenAI instead of direct OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://mcpuser:secure-password@postgres:5432/construction_mcp

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# SECURITY SETTINGS
# ==========================================
# Generate strong random secrets for production
SECRET_KEY=your-256-bit-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# ==========================================
# MONITORING AND LOGGING
# ==========================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log aggregation (optional)
# LOGSTASH_HOST=logstash
# LOGSTASH_PORT=5044

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
# Database backup settings
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ==========================================
# SSL/HTTPS CONFIGURATION
# ==========================================
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

# ==========================================
# CACHE CONFIGURATION
# ==========================================
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=100