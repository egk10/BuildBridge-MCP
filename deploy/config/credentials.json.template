{
  "client_id": "your-azure-app-client-id",
  "client_secret": "your-azure-app-client-secret",
  "tenant_id": "your-azure-tenant-id",
  "sharepoint_site": "https://yourcompany.sharepoint.com/sites/construction",

  // Set to true to run offline with sample data (no Azure creds required)
  "local_mode": false,

  // In local_mode, the Excel connector reads from this folder (relative to repo root)
  "onedrive_folder": "data/sample",

  // Google Sheets Configuration (optional)
  // Choose ONE authentication method: service_account OR oauth
  "google_auth_method": "oauth",  // "service_account" or "oauth"

  // For Service Account authentication (server-to-server)
  "google_service_account_file": "path/to/service-account.json",

  // For OAuth2 authentication (personal Google Drive access)
  "google_credentials_file": "path/to/client_secret.json",
  "google_token_file": "token.pickle",

  "google_sheets": {
    "projects": {
      "sheet_id": "your-google-sheet-id-for-projects",
      "range": "Sheet1!A1:Z1000"
    },
    "budgets": {
      "sheet_id": "your-google-sheet-id-for-budgets",
      "range": "Sheet1!A1:Z1000"
    },
    "schedules": {
      "sheet_id": "your-google-sheet-id-for-schedules",
      "range": "Sheet1!A1:Z1000"
    },
    "resources": {
      "sheet_id": "your-google-sheet-id-for-resources",
      "range": "Sheet1!A1:Z1000"
    }
  },

  // AI Service Configuration
  "ai_service": {
    "openai_api_key": "${OPENAI_API_KEY}",  // Set OPENAI_API_KEY environment variable
    "model": "gpt-4-turbo",
    "max_tokens": 2000,
    "temperature": 0.1,
    "max_retries": 3,
    "retry_delay": 1.0
  },

  "excel_files": {
    "projects": "Project_Database.xlsx",
    "budgets": "Budget_Tracking.xlsx",
    "schedules": "Master_Schedule.xlsx",
    "resources": "Resource_Allocation.xlsx"
  },
  "sharepoint_lists": {
    "projects": "Projects",
    "tasks": "Tasks",
    "safety_incidents": "Safety Incidents",
    "subcontractors": "Subcontractors"
  }
}