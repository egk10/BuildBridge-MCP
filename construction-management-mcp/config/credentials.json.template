  "excel_files": {
    "projects": "Project_Database.xlsx",
    "budgets": "Budget_Tracking.xlsx", 
    "schedules": "Master_Schedule.xlsx",
    "resources": "Resource_Allocation.xlsx"
  },
  "sharepoint_lists": {
    "projects": "Projects",
    "tasks": "Tasks", 
    "safety_incidents": "Safety Incidents",
    "subcontractors": "Subcontractors"
  }
}